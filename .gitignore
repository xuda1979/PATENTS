# ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini
~$*

# ===== AI tool local state =====
.claude/
.future/

# ===== Dependencies / vendored toolchains / virtual envs =====
node_modules/
.venv*/
venv/
.miktex-local/

# ===== Browser profiles & caches (contain cookies / login data) =====
**/browser-automation/profile/
**/profile/Default/
.edge-headless*/

