<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:TPM="http://texlive.dante.de/"><rdf:Description about="http://www.miktex.org/packages/xecjk"><TPM:Name>xecjk</TPM:Name><TPM:Creator>mpc</TPM:Creator><TPM:Title>Support for CJK documents in XeLaTeX</TPM:Title><TPM:Version>3.9.1</TPM:Version><TPM:TargetSystem minVersion=""></TPM:TargetSystem><TPM:Description>A LaTeX package for typesetting CJK documents in the way users have become used to, in the CJK package. The package requires a current version of xtemplate (and hence of the current LaTeX3 development environment).</TPM:Description><TPM:RunFiles size="691585">texmf\fonts\misc\xetex\fontmapping\xecjk\full-stop.map texmf\fonts\misc\xetex\fontmapping\xecjk\full-stop.tec texmf\fonts\misc\xetex\fontmapping\xecjk\fullwidth-stop.map texmf\fonts\misc\xetex\fontmapping\xecjk\fullwidth-stop.tec texmf\fonts\misc\xetex\fontmapping\xecjk\han-simp.map texmf\fonts\misc\xetex\fontmapping\xecjk\han-simp.tec texmf\fonts\misc\xetex\fontmapping\xecjk\han-trad.map texmf\fonts\misc\xetex\fontmapping\xecjk\han-trad.tec texmf\tex\xelatex\xecjk\xeCJK-listings.sty texmf\tex\xelatex\xecjk\xeCJK.cfg texmf\tex\xelatex\xecjk\xeCJK.sty texmf\tex\xelatex\xecjk\xeCJKfntef.sty texmf\tex\xelatex\xecjk\xunicode-addon.sty texmf\tex\xelatex\xecjk\xunicode-extra.def texmf\tpm\packages\xecjk.tpm</TPM:RunFiles><TPM:TimePackaged>1660248725</TPM:TimePackaged><TPM:MD5>076398b1ccaba27a9a6f858c3f3b9217</TPM:MD5><TPM:CTAN path="/macros/xetex/latex/xecjk"/><TPM:Copyright owner="Wenchang Sun" year="2007-2010"/><TPM:License type="lppl1.3c"/></rdf:Description></rdf:RDF>