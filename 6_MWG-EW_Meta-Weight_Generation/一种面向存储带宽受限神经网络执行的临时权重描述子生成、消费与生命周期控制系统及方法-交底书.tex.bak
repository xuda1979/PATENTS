  \draw[cmarrow] (cu) -- (cxu);
  \draw[cmarrow] (cxu) -- (cv);
  \draw[cmarrow] (cv) -- (cy);

  \node[cmwide,fill=black!8] (denyuv) at (5.2,-4.5) {禁止：在外部存储器中\\形成完整矩阵 \(UV\)};
