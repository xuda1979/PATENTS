  \draw[cmdeny] (cv) -- (denyuv);
\end{tikzpicture}
\end{center}
\cmfigurecaption{图4 基于结合律的矩阵执行与禁止外存物化示意图}
\cmdisclosurepara{在优选实施方式中，目标神经网络层为 Transformer 的前馈网络块。系统可以分别针对上投影、门控投影和下投影生成对应的临时权重描述子块，并以块为粒度依次执行“生成一个临时权重描述子块、片上转换并消费、计算当前输出块或者当前梯度块、累积结果、释放当前块、进入下一块”的流程。为提高实现效率，优选在单次持久化内核 启动中完成条件处理、临时权重描述子块生成、片上存储写入、片上转换、矩阵计算、结果累积和生命周期结束处理。}
\cmdisclosurepara{如图5所示，在自回归解码实施方式中，本申请通过避免将大规模静态权重反复写入和读出外部存储器，释放出更多外部存储容量。所述容量可由解码缓存分配器重定向给键值缓存、超长上下文缓存或其他解码状态缓存。优选地，片上存储器包括两个或多个交替使用的缓冲区，在一个缓冲区中由矩阵计算单元消费当前临时权重描述子块时，元生成器和向量计算单元可以在另一缓冲区中生成下一临时权重描述子块，以实现生成路径与矩阵乘加路径的时间重叠。}
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm]
  \node[cmtitle] at (4.3,2.1) {外部存储容量重分配};
  \node[cmwide] (saved) at (1.7,0.9) {节省的外部存储容量\\减少静态权重搬运};
  \node[cmwide] (kv) at (6.9,0.9) {键值缓存 / 长上下文缓存\\可用容量增加};
  \draw[cmarrow] (saved) -- (kv);

  \node[cmtitle] at (4.3,-0.8) {生成路径与计算路径双缓冲重叠};
  \node[cmblock] (sched) at (4.3,-2.1) {生命周期/切换调度器};
  \node[cmwide] (bufa) at (1.8,-3.7) {缓冲区A\\当前描述子块};
  \node[cmwide] (compute) at (6.8,-3.7) {矩阵计算单元\\当前块矩阵计算};
  \node[cmwide] (gen) at (1.8,-5.5) {元生成器 + 向量计算单元\\下一块生成};
  \node[cmwide] (bufb) at (6.8,-5.5) {缓冲区B\\下一描述子块};
  \draw[cmarrow] (bufa) -- (compute);
  \draw[cmarrow] (gen) -- (bufb);
  \draw[cmarrow] (sched) -- (bufa);
  \draw[cmarrow] (sched) -- (gen);
  \draw[cmarrow] (bufb) to[bend left=16] node[below,cmnote] {切换后成为当前缓冲区} (compute);
\end{tikzpicture}
\end{center}
\cmfigurecaption{图5 解码推理中的键值缓存重分配与双缓冲重叠示意图}
\cmdisclosurepara{如图6所示，在训练实施方式中，系统在反向传播阶段不从外部存储器中直接读取完整稠密权重矩阵作为梯度计算操作数，而是由反向重算模块在收到权重读取请求后，再次在片上存储器中生成与当前反向块对应的临时权重描述子块，并由向量计算单元将其转换为当前反向所需的临时目标权重分块或者等效因子分块。随后，矩阵计算单元完成局部梯度块、输入梯度块或参数梯度块的计算；在当前反向块计算结束后，系统即对当前临时对象执行释放、覆写或清零流程，并在对应片上缓冲区被重用前完成所述流程，而不在外部存储器中形成完整稠密矩阵。}
\cmdisclosurepara{在分布式训练实施方式中，优化器与通信门控控制器对与临时权重描述子块对应的局部梯度块实施路径截断。具体地：1．阻止其进入 Adam、AdamW 或其他全局优化器的状态缓存；2．阻止其作为独立大矩阵梯度参与 All-Reduce、Reduce-Scatter 或等效同步；3．仅对元生成器参数、基库参数或者其他压缩参数子集执行跨节点同步。通过上述方式，目标层在网络抓包或通信计数器中表现为同步数据量显著低于稠密基线。}
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm]
  \node[cmmini] (req) at (0.8,1.2) {反向传播\\请求};
  \node[cmwide] (intercept) at (3.6,1.2) {权重读取请求拦截\\不直接读外存};
  \node[cmwide] (recomp) at (6.9,1.2) {反向重算模块\\再次生成描述子块};
  \node[cmwide] (grad) at (6.9,-0.9) {局部梯度块 / 输入梯度块\\片上计算};
  \draw[cmarrow] (req) -- (intercept);
  \draw[cmarrow] (intercept) -- (recomp);
  \draw[cmarrow] (recomp) -- (grad);

  \node[cmwide,fill=black!8] (opt) at (1.9,-3.7) {不进入全局优化器\\状态缓存};
  \node[cmwide,fill=black!8] (sync) at (6.5,-3.7) {不参与 All-Reduce /\\Reduce-Scatter};
  \node[cmwide] (subset) at (10.8,-3.7) {仅同步元生成器参数\\基库参数或压缩参数子集};
  \draw[cmdeny] (grad) -- (opt);
  \draw[cmdeny] (grad) -- (sync);
  \draw[cmarrow] (grad) -- (subset);
\end{tikzpicture}
\end{center}
\cmfigurecaption{图6 训练反向重算与优化器/同步截断示意图}
\cmdisclosurepara{平台实现上，本申请使用平台无关术语进行保护。HBM、片外显存和主板 DDR 可统一抽象为外部存储器；UB、L0A、L0B、shared memory 和 L1 SRAM 可统一抽象为片上存储器；Vector、CUDA Core 和 SIMD Core 可统一抽象为向量计算单元；Cube、Tensor Core 和脉动阵列可统一抽象为矩阵计算单元；HCCS、NVLink、InfiniBand 和 RoCE 可统一抽象为节点间高带宽通信总线。}
\cmdisclosurepara{基于上述模块划分、输入条件、状态机约束以及前向、解码、训练三类处理流程，本领域技术人员可在现有 GPU、NPU、TPU 或其他 AI 加速器的软件栈、运行时系统或片上控制逻辑中实现本方案。实现时可以软件方式落在编译器、运行时和框架插件中，也可以硬件或固件方式落在加速卡控制器与片上存储管理逻辑中；但无论采用何种实现形态，均应满足临时权重对象在全生命周期内不回写外部存储器这一核心约束。}
\cmdisclosurepara{为使技术效果具备统一、可复算的量化支撑，下面给出理论参数量分析与真实加速器实测结果。以 fp16、\(d=4096\)、\(m=14336\) 的三投影门控 FFN 为例，稠密块理论字节量约为 336.0 MiB。不同秩值下的理论有效读取量可通过公式 \((d+m) \times r \times 3\) 投影 \(\times\, 2\) 字节直接计算（见表1）。}
\begin{center}
\cmtablecaption{表1 低秩因子理论参数量与读取量（三投影门控 FFN，fp16，公式推导）}
\vspace{4pt}
\begin{tabular}{cccc}
\hline
秩值 \(r\) & 因子参数量 (MiB) & 读取下降倍数 & 参数占比 \\
\hline
稠密基线 & 336.00 & 1.0$\times$ & 100\% \\
32  & 3.38  & 99.6$\times$ & 1.0\% \\
64  & 6.75  & 49.8$\times$ & 2.0\% \\
128 & 13.50 & 24.9$\times$ & 4.0\% \\
256 & 27.00 & 12.4$\times$ & 8.0\% \\
\hline
\end{tabular}
\end{center}
\cmdisclosurepara{上述数值均为确定性公式推导，不涉及假设或仿真。其中因子参数量 = $(d+m) \times r \times 3$ 投影 $\times\, 2$ 字节 $/\, 2^{20}$，读取下降倍数 = $3dm / [(d+m)r \times 3]$ = $dm / [(d+m)r]$。}
\cmdisclosurepara{按 FFN 替换比例扫描时，系统指标呈线性变化趋势：替换比例越高，模型权重的外部存储占用越低（按表1公式线性推算），节省的容量可分配给键值缓存以扩展最大上下文长度。每层 All-Reduce 同步体积从 336 MiB 降至与元生成器参数量对应的规模（$r=128$ 时约 13.5 MiB/层，下降 96\%）。上述比例趋势的具体实测延迟加速数据详见后续华为昇腾 NPU 实测表格。}
\cmdisclosurepara{在可选增强实施方式中，若对条件信号相近的 token 采用有界时间窗复用，可在牺牲少量精度的前提下进一步降低有效读取和时延。复用窗口越大，元生成器调用次数越少，但可能引入精度漂移。该特征的定量评估有待后续实测补充。同样地，在不同 HBM 带宽档位的加速器平台上（如 1.6--3.2 TB/s），本申请的收益预期在更受带宽限制的平台上更为显著，具体加速倍数有待跨平台实测验证。}

\cmdisclosurepara{\textbf{元生成器参数量与开销量化。} 元生成器自身的可学习参数存储在外部存储器中，但其参数量远小于被替代的稠密权重（参见表1，参数量占比仅 1\%--8\%）。元生成器参数的 HBM 读取开销已包含在后续实测延迟中。实测表明，即使计入元生成器的全部参数读取和前向计算开销，低秩路径仍比稠密基线获得 1.4$\times$--8.7$\times$ 的延迟加速。条件模块的计算开销主要包括激活特征的均值池化和层嵌入查表，二者均为 $O(d)$ 复杂度，相对于目标 FFN 层的 $O(d \cdot m)$ 矩阵乘法可忽略不计。}

\cmdisclosurepara{\textbf{反向重算的计算代价分析。} 传统训练中，前向传播时将完整稠密权重 $W$（$d\times m$）缓存在外部存储器中，反向传播时直接读取缓存的 $W$ 计算梯度。本申请中，反向传播时需要重新生成低秩因子 $U$ 和 $V$，额外引入的重算 FLOPs 为元生成器的前向传播开销。以 8B 模型（$d=4096$, $m=14336$, $r=128$）为例，稠密前向 $x \cdot W$ 的 FLOPs 约 $2 \times 4096 \times 14336 \approx 117.4$M/token；低秩前向 $x \cdot U \cdot V$ 的 FLOPs 约 $2 \times 4096 \times 128 + 2 \times 128 \times 14336 \approx 4.7$M/token（仅 4.0\%）；反向重算需重新执行低秩因子生成（即元生成器前向）和低秩矩阵乘法，其 FLOPs 开销取决于元生成器架构。由于低秩前向本身仅为稠密前向的 4\%，即使元生成器开销与低秩前向相当，反向重算总额外 FLOPs 仍远小于稠密前向，且节省了从外部存储器读取完整 $W$（336 MiB/层）的带宽开销。在带宽受限场景下，用少量计算替代大量访存是净收益的。}

\cmdisclosurepara{\textbf{华为昇腾 Ascend 910B2 NPU 实测验证。} 为使技术效果具备真实加速器硬件实测支撑，本申请进一步在华为昇腾 Ascend 910B2 NPU 上进行了完整的 benchmark 实测（非解析仿真）。测试于 2026 年 4 月完成，使用 PyTorch 2.6.0 配合 torch\_npu 2.6.0，fp16 精度。测试平台为 8 卡 Ascend 910B2，每卡 HBM 容量 60.96 GiB。}

\cmdisclosurepara{以 8B 模型（$d=4096$, $m=14336$）三投影门控 FFN 块为验证对象，稠密权重合计 336.0 MiB，低秩因子仅需存储两个小矩阵 $U$: $d \times r$ 和 $V$: $r \times m$ 共 3 投影。表2--5 分别给出四类场景的实测结果。}

