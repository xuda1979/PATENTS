  \node[cmmini] (cx) at (0.8,-2.7) {输入激活\\\(X\)};
  \node[cmmini] (cu) at (3.0,-2.7) {临时因子块\\\(U\)};
  \node[cmmini] (cxu) at (5.2,-2.7) {中间结果\\\(XU\)};
  \node[cmmini] (cv) at (7.4,-2.7) {临时因子块\\\(V\)};
  \node[cmmini] (cy) at (9.6,-2.7) {输出\\\(Y\)};
