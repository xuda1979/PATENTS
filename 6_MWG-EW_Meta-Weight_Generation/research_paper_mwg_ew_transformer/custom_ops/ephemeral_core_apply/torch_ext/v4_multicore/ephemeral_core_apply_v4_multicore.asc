/*
 * mwg::ephemeral_core_apply - v4 multi-core epilogue (Ascend-C, arm 4)
 *
 * Addresses the beyond-L2 bottleneck identified in the paper's Systems
 * Realization section (Figure~\ref{fig:opdecomp}): the v1 kernel runs the
 * vector epilogue (Tanh/Muls/Adds/Mul/Cast) on a single AICore, and when
 * the core tile exceeds L2 capacity the single-core epilogue becomes the
 * dominant cost (1.93x slower than the materialized arm at T=4096).
 *
 * Design changes from v1 (shipped single-core):
 *
 * 1. M-dimension multi-core distribution: each AICore processes a disjoint
 *    range of M-tiles (tokens), computed from GetBlockIdx()/GetBlockNum().
 *    The v3 attempt relied on the tiling API's N-split, which (a) doesn't
 *    help the vector epilogue bottleneck and (b) triggers aicore exception
 *    507015 under sequential multi-projection calls due to KFC workspace
 *    reuse.  v4 pins baseN=N (no N-split) and distributes M only.
 *
 * 2. Workspace (2026-10-02 corrected): the host allocates the framework
 *    workspace exactly as the official CANN multi-core samples do - one
 *    GetLibApiWorkSpaceSize() region (zeroed after aclrtMalloc) - and the
 *    kernel registers GetSysWorkSpacePtr() (== the launch-provided
 *    __kfc_workspace__ base).  An earlier v4 draft manually sliced the
 *    workspace per blockIdx; for MIX_AIC_1_2 kernels the AIV half reads
 *    its sync tokens from the sys workspace base, so the AIC/AIV
 *    disagreement faulted the last core (aicore 507015, core 7).
 *
 * 3. Double-buffered UB pipeline: BUFFER_NUM=2 on C/act/out queues to
 *    overlap cube (matmul Iterate) and vector (Tanh/Muls/Adds/Mul/Cast)
 *    stages within each core.  v1 had BUFFER_NUM=1, preventing overlap.
 *    baseM is halved to 64 (from 128) to fit 2x buffers in 192 KiB UB.
 *
 * 4. No-write-back contract preserved: the generated core is formed in-place
 *    in the C-tile UB buffer and never written to GM.  The only GM write is
 *    the final fp16 output.  Auditable via the same static source audit as v1.
 *
 * UB budget at baseM=64, H=128, R=128 (fp16 A/B, fp32 C):
 *   2 * (C 32 KiB + act 16 KiB + out 16 KiB) + matmul staging ~32 KiB
 *   = ~160 KiB, within the 192 KiB UB per core on 910B2.
 */

#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <ATen/ATen.h>
#include <torch/library.h>
#include <stdexcept>
#include <mutex>
#include <cmath>
#include <unordered_map>
#include <algorithm>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
using namespace AscendC;

static constexpr int32_t BASE_M_V4 = 64;   // halved from 128 to fit 2x UB buffers
static constexpr int32_t BASE_N_V4 = 128;  // full rank (no N-split)
static constexpr int32_t BASE_K_V4 = 128;  // full controller hidden
static constexpr int32_t BUFFER_NUM_V4 = 2; // double-buffer for cube/vector overlap

#ifndef MWG_SOC_VERSION
#define MWG_SOC_VERSION "Ascend910B2"
#endif

// --- Matmul type aliases (same as v1) ---
using aType = half;
using bType = half;
using cType = float;
using biasType = float;

// Matmul: A[T, H] @ B^T[H, R] + bias[R] -> C[T, R]
using matmulType = matmul::Matmul<
    matmul::MatmulType<TPosition::GM, CubeFormat::ND, aType>,
    matmul::MatmulType<TPosition::GM, CubeFormat::ND, bType>,
    matmul::MatmulType<TPosition::VECIN, CubeFormat::ND, cType>>;

class KernelEphemeralCoreApplyV4 {
 public:
  __aicore__ inline KernelEphemeralCoreApplyV4() {}

  __aicore__ inline void Init(GM_ADDR rankActivation, GM_ADDR controllerHiddenF16,
                              GM_ADDR headWeightTF16, GM_ADDR headBias,
                              GM_ADDR scaledRankActivation,
                              const AscendC::tiling::TCubeTiling& tiling,
                              float amplitude, uint32_t tokenCount,
                              uint32_t hiddenDim, uint32_t rankDim) {
    tiling_ = tiling;
    tokenCount_ = tokenCount;
    hiddenDim_ = hiddenDim;
    rankDim_ = rankDim;
    amplitude_ = amplitude;

    blockIdx_ = GetBlockIdx();
    blockNum_ = GetBlockNum();

    // Global buffer bindings
    aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ aType*>(controllerHiddenF16),
                         tokenCount_ * hiddenDim_);
    bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bType*>(headWeightTF16),
                         rankDim_ * hiddenDim_);
    biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ biasType*>(headBias),
                            rankDim_);
    actGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(rankActivation),
                           tokenCount_ * rankDim_);
    outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scaledRankActivation),
                           tokenCount_ * rankDim_);

    // Compute this core's M-tile range using the compile-time baseM.
    // Each core handles a contiguous block of tokens; the tiling describes
    // this core's SUBMATRIX (host passes M_local = tilesPerCore * baseM,
    // single-core), so no SetDim / manual-offset double-distribution can
    // arise (the committed v4 mixed SetDim with A-offsetting and hung the
    // cube; the 2026-09-28 partial edit removed this assignment entirely,
    // leaving mTileStart_/mTileEnd_ uninitialized garbage).
    const uint32_t baseM = static_cast<uint32_t>(BASE_M_V4);
    const uint32_t totalTiles = (tokenCount_ + baseM - 1) / baseM;
    const uint32_t tilesPerCore =
        (totalTiles + blockNum_ - 1) / blockNum_;
    mTileStart_ = blockIdx_ * tilesPerCore;
    mTileEnd_ = min(mTileStart_ + tilesPerCore, totalTiles);
    mStart_ = mTileStart_ * baseM;

    // Initialize UB queues with double buffering: two buffers per queue
    // let tile i+1's cube work overlap tile i's vector epilogue.
    const uint32_t tileC = static_cast<uint32_t>(BASE_M_V4) * static_cast<uint32_t>(BASE_N_V4);
    pipe_.InitBuffer(cBuf_, BUFFER_NUM_V4, tileC * sizeof(cType));
    pipe_.InitBuffer(actBuf_, BUFFER_NUM_V4, tileC * sizeof(half));
    pipe_.InitBuffer(outBuf_, BUFFER_NUM_V4, tileC * sizeof(half));
  }

  __aicore__ inline void Process() {
    if (mTileStart_ >= mTileEnd_) return;

    // Set matmul tensors for this core's M-range.  The tiling (host side)
    // describes exactly this core's submatrix: A starts at mTileStart_ *
    // baseM rows into the global A; B and bias are shared.
    mm_.SetTensorA(aGm_[mStart_ * hiddenDim_]);
    mm_.SetTensorB(bGm_[0]);
    mm_.SetBias(biasGm_[0]);

    const uint32_t baseM = tiling_.baseM;
    const uint32_t rowLen = rankDim_ * sizeof(half);

    // Iterate over this core's assigned tiles [mTileStart_, mTileEnd_).
    // The tiling's M equals tilesPerCore * baseM, so Iterate exhausts the
    // submatrix in lockstep with this loop.
    const int32_t localTiles =
        static_cast<int32_t>(mTileEnd_ - mTileStart_);
    int32_t localTileIdx = 0;
    while (localTileIdx < localTiles && mm_.template Iterate<true>()) {
      int32_t globalTileIdx = static_cast<int32_t>(mTileStart_) + localTileIdx;
      int32_t rowsDone = globalTileIdx * static_cast<int32_t>(baseM);
      int32_t actualRows = min(static_cast<int32_t>(baseM),
                               static_cast<int32_t>(tokenCount_) - rowsDone);
      if (actualRows <= 0) break;
      int32_t count = actualRows * static_cast<int32_t>(rankDim_);

      DataCopyParams actCopy{
          static_cast<uint16_t>(actualRows),
          static_cast<uint16_t>(rowLen / AscendC::DEFAULT_C0_SIZE), 0, 0};

      // Stage activation tile
      AscendC::LocalTensor<half> actLocal = actBuf_.AllocTensor<half>();
      DataCopy(actLocal, actGm_[rowsDone * rankDim_], actCopy);
      actBuf_.EnQue(actLocal);
      actBuf_.DeQue<half>();

      // Get matmul C tile
      AscendC::LocalTensor<cType> cLocal = cBuf_.AllocTensor<cType>();
      mm_.template GetTensorC<true>(cLocal, false, true);
      cBuf_.EnQue(cLocal);
      cBuf_.DeQue<cType>();

      // Vector epilogue: z = 1 + amplitude * tanh(C), then y = act * z
      AscendC::LocalTensor<half> outLocal = outBuf_.AllocTensor<half>();

      AscendC::Tanh(cLocal, cLocal, count);
      AscendC::Muls(cLocal, cLocal, amplitude_, count);
      AscendC::Adds(cLocal, cLocal, static_cast<float>(1.0), count);
      AscendC::Cast(outLocal, cLocal, AscendC::RoundMode::CAST_NONE, count);
      AscendC::Mul(outLocal, outLocal, actLocal, count);

      outBuf_.EnQue(outLocal);
      outBuf_.DeQue<half>();
      DataCopy(outGm_[rowsDone * rankDim_], outLocal, actCopy);

      outBuf_.FreeTensor(outLocal);
      actBuf_.FreeTensor(actLocal);
      cBuf_.FreeTensor(cLocal);
      localTileIdx++;
    }
    mm_.End();
  }

 public:
  TPipe pipe_;
  matmulType mm_;
  AscendC::tiling::TCubeTiling tiling_;

 private:
  TQue<QuePosition::VECOUT, BUFFER_NUM_V4> cBuf_;
  TQue<QuePosition::VECIN, BUFFER_NUM_V4> actBuf_;
  TQue<QuePosition::VECOUT, BUFFER_NUM_V4> outBuf_;
  GlobalTensor<aType> aGm_;
  GlobalTensor<bType> bGm_;
  GlobalTensor<biasType> biasGm_;
  GlobalTensor<half> actGm_;
  GlobalTensor<half> outGm_;
  uint32_t tokenCount_;
  uint32_t hiddenDim_;
  uint32_t rankDim_;
  float amplitude_;
  uint32_t blockIdx_;
  uint32_t blockNum_;
  uint32_t mTileStart_;
  uint32_t mTileEnd_;
  uint32_t mStart_;
};

// Kernel entry point.  The __kfc_workspace__ parameter is the sys
// workspace the host allocated (GetLibApiWorkSpaceSize bytes, zeroed);
// REGIST_MATMUL_OBJ below uses GetSysWorkSpacePtr() which aliases this
// same buffer - see header comment 2.
extern "C" __global__ __aicore__ void ephemeral_core_apply_v4_kernel(
    GM_ADDR rankActivation, GM_ADDR controllerHiddenF16,
    GM_ADDR headWeightTF16, GM_ADDR headBias,
    GM_ADDR scaledRankActivation,
    __kfc_workspace__ GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, float amplitude, uint32_t tokenCount,
    uint32_t hiddenDim, uint32_t rankDim) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  KernelEphemeralCoreApplyV4 op;
  op.Init(rankActivation, controllerHiddenF16, headWeightTF16, headBias,
          scaledRankActivation, tiling, amplitude, tokenCount, hiddenDim,
          rankDim);
  // 2026-10-02 fix (diag10 root cause): register the SYS workspace
  // (GetSysWorkSpacePtr() == para_base[WORKSPACE_PARAM_OFFSET], i.e. the
  // launch-provided __kfc_workspace__ base), NOT a manually blockIdx-sliced
  // region.  For MIX_AIC_1_2 kernels the compiler-generated AIV half reads
  // its sync tokens from the sys workspace base; registering a different
  // (sliced) buffer left the AIV reading from garbage -> fftsplus/aivector
  // MTE fault on the last core (aicore 507015, core 7, diag10 plog
  // task_id=22).  The official CANN 8.5 multi-core samples
  // (MatmulCustomMultiCore, blockDim=2) register GetSysWorkSpacePtr() with
  // the host allocating exactly GetLibApiWorkSpaceSize() - the runtime, not
  // the kernel, handles per-block layout.  This matches shipped v1, which
  // has thousands of clean device calls.
  REGIST_MATMUL_OBJ(&op.pipe_, GetSysWorkSpacePtr(), op.mm_, &op.tiling_);
  op.Process();
}

// ---- host-side tiling (runs on CPU) ----
static AscendC::tiling::TCubeTiling GenerateTilingV4(
    platform_ascendc::PlatformAscendC* platform, uint32_t M, uint32_t N,
    uint32_t K, uint32_t blockDim) {
  using TPosition = matmul_tiling::TPosition;
  using CubeFormat = matmul_tiling::CubeFormat;
  using DataType = matmul_tiling::DataType;

  // Same tiling API as the shipped v1 host wrapper (CANN 8.5 exposes
  // MultiCoreMatmulTiling, not MatmulApiDto).  IMPORTANT: the tiling
  // describes ONE CORE'S SUBMATRIX, so SetDim is NOT used (default 1);
  // multi-core distribution comes solely from the kernel-side tile
  // partition (mTileStart_/mTileEnd_) plus the per-core A offset.  The
  // committed v4 mixed SetDim(blockDim) with manual A-offsetting, double-
  // distributing M and hanging the cube (aicore timeout on device).
  matmul_tiling::MultiCoreMatmulTiling api(*platform);
  // M-only distribution: pin singleCoreN = N so no N-split (the v3 N-split
  // path was the 507015 fault source).
  api.SetAType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT16, false);
  api.SetBType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT16, false);
  api.SetCType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT);
  api.SetBiasType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT);
  api.SetOrgShape(M, N, K);
  api.SetShape(M, N, K);
  api.SetBias(true);
  api.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
  api.SetBufferSpace(-1, -1, -1);

  AscendC::tiling::TCubeTiling tiling;
  int64_t res = api.GetTiling(tiling);
  if (res == -1) {
    throw std::runtime_error("mwg: v4 tiling generation failed");
  }
  // Pin the kernel-visible block geometry: full-N tiles, baseM from the
  // kernel constant, single-step traversal (kernel drives its own M loop).
  tiling.baseN = N;
  tiling.stepN = 1;
  tiling.baseM = static_cast<uint32_t>(BASE_M_V4);
  tiling.stepM = 1;
  return tiling;
}

// ---- host wrapper (eager torch) ----
namespace mwg {

static std::mutex g_v4_cache_mu;

at::Tensor ephemeral_core_apply_v4(const at::Tensor& rank_activation,
                                   const at::Tensor& controller_hidden,
                                   const at::Tensor& head_weight,
                                   const at::Tensor& head_bias,
                                   double amplitude) {
  TORCH_CHECK(rank_activation.device().type() == c10::kPrivateUse1,
              "mwg: v4 requires NPU device");
  TORCH_CHECK(rank_activation.is_contiguous() && controller_hidden.is_contiguous(),
              "mwg: inputs must be contiguous");
  TORCH_CHECK(rank_activation.scalar_type() == at::kHalf,
              "mwg: rank_activation must be fp16");
  TORCH_CHECK(controller_hidden.scalar_type() == at::kFloat,
              "mwg: controller_hidden must be fp32");

  auto act2d = rank_activation.reshape({rank_activation.size(0), -1});
  auto ctrl2d = controller_hidden.reshape({controller_hidden.size(0), -1});
  uint32_t t = static_cast<uint32_t>(act2d.size(0));
  uint32_t h = static_cast<uint32_t>(ctrl2d.size(1));
  uint32_t r = static_cast<uint32_t>(act2d.size(1));

  // Multi-core configuration: up to 8 cores on 910B2.  T must be a
  // multiple of BASE_M_V4: each core advances its own M traversal from a
  // manually offset A pointer with a full-M tiling, so the framework's
  // M-edge zero-padding logic never fires per core and a non-multiple T
  // would let the tail core's cube read past the A tensor end.
  TORCH_CHECK(t % static_cast<uint32_t>(BASE_M_V4) == 0,
              "mwg: v4 requires T divisible by ", BASE_M_V4,
              " (got T=", t, ")");
  uint32_t baseM = static_cast<uint32_t>(BASE_M_V4);
  uint32_t totalTiles = (t + baseM - 1) / baseM;
  uint32_t maxCores = 8u;
  uint32_t block_dim = (totalTiles < maxCores) ? totalTiles : maxCores;
  if (block_dim < 1) block_dim = 1;

  // Workspace (2026-10-02 corrected): allocate exactly the framework's
  // GetLibApiWorkSpaceSize() ONCE (mirroring the official CANN 8.5
  // multi-core samples and the shipped v1), zero it on allocation, and
  // let the kernel register GetSysWorkSpacePtr().  Earlier v4 drafts
  // sliced the workspace per core (128 KiB -> libWs -> libWs*blockDim
  // variants); every manual-slicing variant faulted on device (507014 /
  // 507015) because for MIX_AIC_1_2 kernels the AIV half reads sync
  // tokens from the sys workspace BASE, which must be the buffer the AIC
  // registers - the runtime handles per-block layout, not the kernel.

  // Cached tiling and workspace
  static thread_local bool g_valid = false;
  static thread_local AscendC::tiling::TCubeTiling g_tiling{};
  static thread_local void *g_workspace = nullptr;
  static thread_local size_t g_workspace_size = 0;
  static thread_local uint32_t g_key_t = 0, g_key_h = 0, g_key_r = 0;
  static thread_local uint32_t g_key_dim = 0;

  std::lock_guard<std::mutex> lk(g_v4_cache_mu);
  if (!g_valid || g_key_t != t || g_key_h != h || g_key_r != r ||
      g_key_dim != block_dim) {
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance(
        MWG_SOC_VERSION);
    // Per-core submatrix M: identical partition arithmetic to the kernel's
    // Init (tilesPerCore = ceil(totalTiles / block_num)), so the tiling's
    // M exactly covers one core's assigned tile range.
    uint32_t tilesPerCore = (totalTiles + block_dim - 1) / block_dim;
    uint32_t mLocal = tilesPerCore * baseM;
    g_tiling = GenerateTilingV4(platform, mLocal, r, h, block_dim);
    g_key_dim = block_dim;
    // Framework workspace, canonical sizing (2026-10-02): one
    // GetLibApiWorkSpaceSize() region for the whole launch, exactly as
    // the official multi-core samples and shipped v1 allocate.  The
    // kernel registers GetSysWorkSpacePtr() (this same buffer); the
    // runtime manages per-block internal layout.
    size_t libWs = static_cast<size_t>(platform->GetLibApiWorkSpaceSize());
    size_t ws = (libWs + 511u) & ~static_cast<size_t>(511u);
    if (ws > g_workspace_size) {
      if (g_workspace) aclrtFree(g_workspace);
      void *p = nullptr;
      if (aclrtMalloc(&p, ws, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        TORCH_CHECK(false, "mwg: v4 workspace aclrtMalloc failed");
      }
      // 2026-10-02 root-cause fix (v1z change (a)): zero the freshly
      // allocated workspace; reused uninitialized aclrtMalloc bytes can
      // poison the KFC matmul handshake on the first launch(es) after a
      // dirty allocation (diag6/diag8).
      if (aclrtMemset(p, ws, 0, ws) != ACL_SUCCESS) {
        aclrtFree(p);
        g_workspace = nullptr;
        g_workspace_size = 0;
        TORCH_CHECK(false, "mwg: v4 workspace aclrtMemset failed");
      }
      g_workspace = p;
      g_workspace_size = ws;
    }
    g_valid = true;
    g_key_t = t; g_key_h = h; g_key_r = r;
  }
  AscendC::tiling::TCubeTiling tiling = g_tiling;
  void *workspace_ptr = g_workspace;

  // Pre-launch sync (same as v1: ensure prior async casts complete)
  auto acl_stream_pre = c10_npu::getCurrentNPUStream().stream(false);
  aclrtSynchronizeStream(acl_stream_pre);

  // Cast controller_hidden to fp16 (per-call, not cached)
  auto a_f16 = ctrl2d.to(at::kHalf);
  // Cast weight to fp16.  head_weight follows the SAME [H, R] contract as
  // v1 (ctrl[T,H] @ head_weight[H,R] + bias[R]): used directly, NO
  // transpose.  The 2026-09-30 pre-deploy audit caught this block
  // transposing with head_weight.t() while the tiling declares
  // isTrans=false -- v4 would have computed ctrl @ W^T and failed
  // equivalence against the [H, R] reference at the next device window.
  // 2026-10-02 root-cause fix (diag7 S3/S4, same as v1): the previous
  // pointer-keyed fp16 cache served STALE bytes when a new weight tensor
  // landed at a recycled device address.  Cast per call now.
  at::Tensor b_f16 = head_weight.contiguous().to(at::kHalf);  // [H, R] fp16, no transpose
  auto a_f16_2d = a_f16.reshape({a_f16.size(0), -1}).contiguous();

  // Allocate output
  auto out = at::empty_like(act2d);

  // Launch.  2026-10-02 first-call settle (diag6/diag8/diag9): the first
  // 1-2 custom launches in a process can return corrupted (wrong-finite)
  // output due to CANN-side lazy initialization of the KFC/aicore path
  // (diag8: err 0.1529 on call 1 for BOTH arms, self-healed by call 2;
  // diag6 worst case: 2 consecutive bad launches, self-healed by call 3).
  // On the first call per thread, run 2 discarded settle launches into
  // the output buffer and then the real launch, keeping only the final
  // result: every launch writes the full output tile, so the returned
  // tensor is correct by construction; the 2 extra launches are paid
  // once per thread.
  static thread_local uint32_t g_v4_settle_done = 0;
  auto acl_stream = c10_npu::getCurrentNPUStream().stream(false);
  if (g_v4_settle_done == 0) {
    // Verified warmup (2026-10-02 diag9 postmortem, same rationale as v1):
    // the bad-launch streak is runtime-global and VARIABLE (diag9 S1: v1's
    // first 3 settle launches ALL bad; diag6 saw 2; diag8 saw 1).  Verify
    // convergence on a fixed deterministic probe before trusting the path.
    constexpr uint32_t kWarmT = 128, kWarmH = 128, kWarmR = 128;
    constexpr float kWarmAmp = 0.05f;
    auto warmAct = at::ones({kWarmT, kWarmR},
                            act2d.options().dtype(at::kHalf));
    auto warmCtrl = at::full({kWarmT, kWarmH}, 0.25,
                             act2d.options().dtype(at::kHalf));
    auto warmW = at::full({kWarmH, kWarmR}, 0.5,
                          head_bias.options().dtype(at::kHalf));
    auto warmBias = at::zeros({kWarmR},
                              head_bias.options().dtype(at::kFloat));
    auto warmOut = at::empty_like(warmAct);
    const float kWarmCore =
        std::tanh(0.25f * static_cast<float>(kWarmH) * 0.5f) * kWarmAmp + 1.0f;
    // Warmup must use a single-core launch: block_dim>1 changes the tiling
    // M (per-core partition arithmetic in Init); a fresh warmTiling is
    // generated for the 1-core geometry so the warmup kernel is coherent.
    auto warmPlatform = platform_ascendc::PlatformAscendCManager::GetInstance(
        MWG_SOC_VERSION);
    auto warmTiling = GenerateTilingV4(warmPlatform, kWarmT, kWarmR, kWarmH, 1u);
    bool warmOk = false;
    for (uint32_t attempt = 0; attempt < 16 && !warmOk; ++attempt) {
      ephemeral_core_apply_v4_kernel<<<1u, nullptr, acl_stream>>>(
          static_cast<uint8_t*>(warmAct.data_ptr()),
          static_cast<uint8_t*>(warmCtrl.data_ptr()),
          static_cast<uint8_t*>(warmW.data_ptr()),
          static_cast<uint8_t*>(warmBias.data_ptr()),
          static_cast<uint8_t*>(warmOut.data_ptr()),
          static_cast<uint8_t*>(workspace_ptr), warmTiling,
          kWarmAmp, kWarmT, kWarmH, kWarmR);
      aclrtSynchronizeStream(acl_stream);
      auto hostOut = warmOut.to(at::kCPU).to(at::kFloat);
      warmOk = bool((hostOut - kWarmCore).abs().max().item<float>()
                    < 5e-3f);
    }
    TORCH_CHECK(warmOk,
                "mwg: ephemeral_core_apply_v4 warmup failed to converge "
                "after 16 attempts (KFC/aicore path did not initialize)");
    g_v4_settle_done = 1;
  }
  {
    ephemeral_core_apply_v4_kernel<<<block_dim, nullptr, acl_stream>>>(
      static_cast<uint8_t*>(act2d.data_ptr()),
      static_cast<uint8_t*>(a_f16_2d.data_ptr()),
      static_cast<uint8_t*>(b_f16.data_ptr()),
      static_cast<uint8_t*>(head_bias.data_ptr()),
      static_cast<uint8_t*>(out.data_ptr()),
      static_cast<uint8_t*>(workspace_ptr), tiling,
      static_cast<float>(amplitude), t, h, r);
  }

  // Sync: temporaries must stay alive until kernel completes
  aclrtSynchronizeStream(acl_stream);
  return out.view(rank_activation.sizes());
}

}  // namespace mwg

// The v4 library registers only the v4 op, in FRAGMENT form: the v1 op
// (mwg::ephemeral_core_apply) is registered by the separately-loaded
// libcustom_ops.so with a full TORCH_LIBRARY(mwg) block, and two full
// registrations of the same namespace are rejected by the PyTorch
// dispatcher at load time.  A fragment may coexist with the full block.
TORCH_LIBRARY_FRAGMENT(mwg, m) {
  m.def("ephemeral_core_apply_v4(Tensor rank_activation, Tensor controller_hidden, "
        "Tensor head_weight, Tensor head_bias, float amplitude) -> Tensor");
}
TORCH_LIBRARY_IMPL(mwg, PrivateUse1, m) {
  m.impl("ephemeral_core_apply_v4", TORCH_FN(mwg::ephemeral_core_apply_v4));
}
