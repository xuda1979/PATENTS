
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <ATen/ATen.h>
#include <torch/library.h>
#include <stdexcept>
#include <mutex>
#include <cmath>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
using namespace AscendC;

static constexpr int32_t BASE_M = 128;
static constexpr int32_t BASE_N = 128;
static constexpr int32_t BASE_K = 128;
// Soc version string for the host-side tiling platform lookup.  Must match
// the device (e.g. "Ascend910B2"); override with -DMWG_SOC_VERSION=... for
// other 910B variants.
#ifndef MWG_SOC_VERSION
#define MWG_SOC_VERSION "Ascend910B2"
#endif

using aType = half;
using bType = half;
using cType = float;
using biasType = float;

// head_weight is transposed by the host to [R, H]; declaring isTrans=true on
// the B operand makes the matmul treat it as [H, R] (A[T,H] @ B[H,R]).
// head_weight is transposed by the host to [R, H]; declaring isTrans=true on
// the B operand makes the matmul treat it as [H, R] (A[T,H] @ B[H,R]).
using matmulType = matmul::Matmul<
    matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, aType>,
    matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, bType>,
    matmul::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, cType>>;

class KernelEphemeralCoreApply {
 public:
  __aicore__ inline KernelEphemeralCoreApply() {}

  __aicore__ inline void Init(GM_ADDR rankActivation, GM_ADDR controllerHiddenF16,
                              GM_ADDR headWeightTF16, GM_ADDR headBias,
                              GM_ADDR scaledRankActivation, GM_ADDR workspace,
                              const AscendC::tiling::TCubeTiling& tiling,
                              float amplitude, uint32_t tokenCount,
                              uint32_t hiddenDim, uint32_t rankDim) {
    tiling_ = tiling;
    tokenCount_ = tokenCount;
    hiddenDim_ = hiddenDim;
    rankDim_ = rankDim;
    amplitude_ = amplitude;
    // Inputs are cast to fp16 by the host wrapper (cube requires fp16 A/B);
    // the matmul accumulates in fp32 (cType/biasType float).
    aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ aType *>(controllerHiddenF16),
                         tokenCount_ * hiddenDim_);
    bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bType *>(headWeightTF16),
                         hiddenDim_ * rankDim_);
    biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ biasType *>(headBias),
                            rankDim_);
    actGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(rankActivation),
                           tokenCount_ * rankDim_);
    outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(scaledRankActivation),
                           tokenCount_ * rankDim_);
    InitQueues();
  }

  __aicore__ inline void InitQueues() {
    // Size tiles by the GENERATED tiling (the tiling API may pick base
    // blocks smaller than the compile-time maximum), leaving UB headroom
    // for the matmul's own staging.
    const uint32_t tile = tiling_.baseM * tiling_.baseN;
    pipe_.InitBuffer(cBuf_, 1, tile * sizeof(cType));
    pipe_.InitBuffer(actBuf_, 1, tile * sizeof(half));
    pipe_.InitBuffer(outBuf_, 1, tile * sizeof(half));
  }

  __aicore__ inline void Process() {
    // Runtime diagnostic: amplitude == -1 selects a constant-fill path that
    // bypasses the matmul entirely.  If the output fills with 3.0 the
    // launch + UB->GM copy path work and the fault is in the matmul/core
    // path; if it stays zero the kernel never executes.
    if (amplitude_ == -1.0f) {
      const uint32_t baseM0 = tiling_.baseM;
      const uint32_t mTiles0 = (tokenCount_ + baseM0 - 1) / baseM0;
      const uint32_t rowLen0 = rankDim_ * sizeof(half);
      for (int32_t r0 = 0; r0 < static_cast<int32_t>(mTiles0); ++r0) {
        int32_t done0 = r0 * baseM0;
        int32_t rows0 =
            min(static_cast<int32_t>(baseM0),
                static_cast<int32_t>(tokenCount_ - done0));
        int32_t cnt0 = rows0 * rankDim_;
        DataCopyParams cp0{static_cast<uint16_t>(rows0),
                           static_cast<uint16_t>(
                               rowLen0 / AscendC::DEFAULT_C0_SIZE),
                           0, 0};
        AscendC::LocalTensor<half> fillLocal = outBuf_.AllocTensor<half>();
        AscendC::Duplicate(fillLocal, static_cast<half>(3.0), cnt0);
        outBuf_.EnQue(fillLocal);
        outBuf_.DeQue<half>();
        DataCopy(outGm_[done0 * rankDim_], fillLocal, cp0);
        outBuf_.FreeTensor(fillLocal);
      }
      return;
    }
    // Canonical queue protocol (AllocTensor -> EnQue -> DeQue -> use ->
    // FreeTensor) as in the canonical matmul sample; buffer geometry is
    // tiling-driven (base blocks may be smaller than the compile max).
    const uint32_t baseM = tiling_.baseM;
    const uint32_t rowLen = rankDim_ * sizeof(half);
    // Tensor bindings are set HERE, after REGIST_MATMUL_OBJ has run (the
    // sample binds inside Process for exactly this reason).
    mm_.SetTensorA(aGm_);
    mm_.SetTensorB(bGm_);
    mm_.SetBias(biasGm_);
    int32_t mRound = 0;
    while (mm_.template Iterate<true>()) {
      AscendC::LocalTensor<half> actLocal = actBuf_.AllocTensor<half>();
      int32_t rowsDone = mRound * baseM;
      int32_t actualRows =
          min(static_cast<int32_t>(baseM),
              static_cast<int32_t>(tokenCount_ - rowsDone));
      int32_t count = actualRows * rankDim_;
      // DataCopyParams are in 32-byte blocks with stride = row gap
      // (canonical-sample idiom); rows are back-to-back so gap is 0.
      DataCopyParams actCopy{
          static_cast<uint16_t>(actualRows),
          static_cast<uint16_t>(rowLen / AscendC::DEFAULT_C0_SIZE), 0, 0};
      DataCopy(actLocal, actGm_[rowsDone * rankDim_], actCopy);
      actBuf_.EnQue(actLocal);
      actBuf_.DeQue<half>();

      AscendC::LocalTensor<cType> cLocal = cBuf_.AllocTensor<cType>();
      mm_.template GetTensorC<true>(cLocal, false, true);
      // Sample idiom: the C tile must round-trip the queue so the vector
      // ops observe a completed cube write (EnQue/DeQue is the sync point).
      cBuf_.EnQue(cLocal);
      cBuf_.DeQue<cType>();
      AscendC::Tanh(cLocal, cLocal, count);
      AscendC::Muls(cLocal, cLocal, amplitude_, count);
      AscendC::Adds(cLocal, cLocal, static_cast<float>(1.0), count);

      AscendC::LocalTensor<half> outLocal = outBuf_.AllocTensor<half>();
      if (amplitude_ == -2.0f) {
        // Core-only diagnostic: out = 1 + 0.5*tanh(A@B+bias).
        AscendC::Cast(outLocal, cLocal, AscendC::RoundMode::CAST_NONE, count);
      } else {
        // out = act * core, both fp16 (core tile cast in place).
        AscendC::Cast(outLocal, cLocal, AscendC::RoundMode::CAST_NONE, count);
        AscendC::Mul(outLocal, outLocal, actLocal, count);
      }
      outBuf_.EnQue(outLocal);
      outBuf_.DeQue<half>();
      DataCopy(outGm_[rowsDone * rankDim_], outLocal, actCopy);

      outBuf_.FreeTensor(outLocal);
      actBuf_.FreeTensor(actLocal);
      cBuf_.FreeTensor(cLocal);
      mRound++;
    }
    mm_.End();
  }

 public:
  TPipe pipe_;
  matmulType mm_;
  AscendC::tiling::TCubeTiling tiling_;

 private:
  TQue<QuePosition::VECOUT, 1> cBuf_;
  TQue<QuePosition::VECIN, 1> actBuf_;
  TQue<QuePosition::VECOUT, 1> outBuf_;  // GM-write staging sits on the output queue (sample idiom)
  GlobalTensor<aType> aGm_;
  GlobalTensor<bType> bGm_;
  GlobalTensor<biasType> biasGm_;
  GlobalTensor<half> actGm_;
  GlobalTensor<half> outGm_;
  uint32_t tokenCount_;
  uint32_t hiddenDim_;
  uint32_t rankDim_;
  float amplitude_;
};

extern "C" __global__ __aicore__ void ephemeral_core_apply_kernel(
    GM_ADDR rankActivation, GM_ADDR controllerHiddenF16, GM_ADDR headWeightTF16,
    GM_ADDR headBias, GM_ADDR scaledRankActivation,
    __kfc_workspace__ GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, float amplitude, uint32_t tokenCount,
    uint32_t hiddenDim, uint32_t rankDim) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  KernelEphemeralCoreApply op;
  op.Init(rankActivation, controllerHiddenF16, headWeightTF16, headBias,
          scaledRankActivation, workspace, tiling, amplitude, tokenCount,
          hiddenDim, rankDim);
  REGIST_MATMUL_OBJ(&op.pipe_, GetSysWorkSpacePtr(), op.mm_, &op.tiling_);
  op.Process();
}

// ---- host-side tiling (runs on CPU) ----
AscendC::tiling::TCubeTiling GenerateTiling(
    platform_ascendc::PlatformAscendC* platform, uint32_t M, uint32_t N,
    uint32_t K, uint32_t blockDim) {
  using TPosition = matmul_tiling::TPosition;
  using CubeFormat = matmul_tiling::CubeFormat;
  using DataType = matmul_tiling::DataType;
  matmul_tiling::MultiCoreMatmulTiling api(*platform);
  api.SetDim(blockDim);
  // blockDim > 1: pin baseN to N so the API cannot split N (16-wide cubes
  // are inefficient and duplicate A reads); it must split M instead, which
  // the kernel's CalcOffset handles.
  api.SetAType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT16, false);
  api.SetBType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT16, false);
  api.SetCType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT);
  api.SetBiasType(TPosition::GM, CubeFormat::ND, DataType::DT_FLOAT);
  api.SetOrgShape(M, N, K);
  api.SetShape(M, N, K);
  api.SetBias(true);
  api.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
  // Let the API pick base-block sizes that fit the (small) M dimension;
  // a fixed 128x128 split is infeasible when T < 128 and returns -1.
  api.SetBufferSpace(-1, -1, -1);
  AscendC::tiling::TCubeTiling tiling;
  int64_t res = api.GetTiling(tiling);
  if (res == -1) {
    throw std::runtime_error("mwg: tiling generation failed");
  }
  tiling.stepM = 1;
  tiling.stepN = 1;
  return tiling;
}

// ---- host wrapper (eager torch) ----
namespace mwg {
at::Tensor ephemeral_core_apply(const at::Tensor& rank_activation,
                                const at::Tensor& controller_hidden,
                                const at::Tensor& head_weight,
                                const at::Tensor& head_bias, double amplitude) {
  TORCH_CHECK(rank_activation.is_contiguous() && controller_hidden.is_contiguous(),
              "mwg: inputs must be contiguous");
  TORCH_CHECK(rank_activation.scalar_type() == at::kHalf,
              "mwg: rank_activation must be fp16");
  TORCH_CHECK(controller_hidden.scalar_type() == at::kFloat,
              "mwg: controller_hidden must be fp32");
  TORCH_CHECK(rank_activation.device().type() == c10::kPrivateUse1,
              "mwg: rank_activation must be on NPU");
  // The harness may pass [B, S, R] activations (and [B, S, H] hidden);
  // flatten to leading-token x feature for the kernel, then restore shape.
  auto act2d = rank_activation.contiguous().view(
      {-1, rank_activation.size(-1)});
  auto ctrl2d = controller_hidden.contiguous().view(
      {-1, controller_hidden.size(-1)});
  auto out = at::empty_like(act2d);
  auto weight_t = head_weight;  // [H, R] used directly (no transpose)
  // 2026-10-02 root-cause fix (diag7 S3/S4): the previous pointer-keyed
  // fp16 cache (unordered_map<void*, Tensor> keyed by data_ptr) served
  // STALE bytes whenever a NEW weight tensor landed at a recycled device
  // address (silent wrong-finite corruption, err ~0.14 vs fp16 noise
  // ~0.001; reproduced and confirmed by the v1z A/B).  The fp32->fp16
  // weight cast is now performed on every call.
  at::Tensor b_f16 = weight_t.to(at::kHalf);
  // Activation cast is per-call data (not cacheable).
  auto a_f16 = ctrl2d.to(at::kHalf);
  // The fp16 casts are async stream ops; the custom kernel launch must not
  // race with them (observed as non-deterministic NaN/garbage C tiles).
  auto acl_stream_pre = c10_npu::getCurrentNPUStream().stream(false);
  aclrtSynchronizeStream(acl_stream_pre);
  uint32_t t = static_cast<uint32_t>(act2d.size(0));
  uint32_t h = static_cast<uint32_t>(ctrl2d.size(1));
  uint32_t r = static_cast<uint32_t>(act2d.size(1));

  // Host-side fast path: the tiling is deterministic in (soc, T, H, R) and
  // GetTiling costs ~100s of us; cache it.  The system workspace is a
  // fixed-size buffer allocated once and reused across calls (the launch
  // is stream-ordered, and we synchronize before returning, so reuse is
  // race-free for the single-stream eager path).
  static thread_local std::mutex g_mwg_cache_mu;
  static thread_local uint32_t g_key_t = 0, g_key_h = 0, g_key_r = 0;
  static thread_local bool g_valid = false;
  static thread_local AscendC::tiling::TCubeTiling g_tiling{};
  static thread_local void *g_workspace = nullptr;
  static thread_local size_t g_workspace_size = 0;

  // Shipped configuration: single-core launch (block_dim=1).  A v3
  // 8-core M/N-split variant is correct standalone (equivalence PASSED)
  // but triggers aicore exception 507015 under the harness's sequential
  // multi-projection call pattern (suspected KFC workspace reuse across
  // back-to-back 8-core launches); it is archived as v3_multicore.asc.
  uint32_t block_dim = 1u;

  std::lock_guard<std::mutex> lk(g_mwg_cache_mu);
  static thread_local uint32_t g_key_dim = 0;
  if (!g_valid || g_key_t != t || g_key_h != h || g_key_r != r ||
      g_key_dim != block_dim) {
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance(
        MWG_SOC_VERSION);
    g_tiling = GenerateTiling(platform, t, r, h, block_dim);
    g_key_dim = block_dim;
    size_t ws = platform->GetLibApiWorkSpaceSize();
    if (ws > g_workspace_size) {
      if (g_workspace) aclrtFree(g_workspace);
      void *p = nullptr;
      if (aclrtMalloc(&p, ws, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        TORCH_CHECK(false, "mwg: workspace aclrtMalloc failed");
      }
      // 2026-10-02 root-cause fix (v1z change (a)): zero the freshly
      // allocated workspace.  Reused uninitialized aclrtMalloc bytes can
      // poison the KFC matmul handshake on the first launch(es) after a
      // dirty allocation (diag6/diag8: call-1/2 garbage/NaN that
      // self-heals by call 3).
      if (aclrtMemset(p, ws, 0, ws) != ACL_SUCCESS) {
        aclrtFree(p);
        g_workspace = nullptr;
        g_workspace_size = 0;
        TORCH_CHECK(false, "mwg: workspace aclrtMemset failed");
      }
      g_workspace = p;
      g_workspace_size = ws;
    }
    g_key_t = t; g_key_h = h; g_key_r = r; g_valid = true;
  }
  AscendC::tiling::TCubeTiling tiling = g_tiling;
  void *workspace_ptr = g_workspace;
  auto acl_stream = c10_npu::getCurrentNPUStream().stream(false);
  // 2026-10-02 first-call settle (diag6/diag8/diag9): the first 1-2
  // custom launches in a process can return corrupted (wrong-finite)
  // output due to CANN-side lazy initialization of the KFC/aicore path -
  // this hit diag8's BOTH arms (err 0.1529 on call 1, self-healed by
  // call 2) and diag9's v1 first call identically, independent of our
  // kernel code; diag6's worst case was 2 consecutive bad launches
  // (self-healed by call 3).  Absorb the worst case: on the first call
  // per thread, run 2 discarded settle launches into the output buffer
  // and then the real launch, keeping only the final result.  Every
  // launch writes the full output tile, so the returned tensor is
  // correct by construction; the cost (2 extra kernels) is paid once
  // per thread.
  static thread_local uint32_t g_settle_done = 0;
  if (g_settle_done == 0) {
    // Verified warmup (2026-10-02 diag9 postmortem): diag9 S1 proved the
    // bad-launch streak is runtime-global and VARIABLE (v1's first 3
    // settle launches ALL returned tanh-saturated garbage, err 0.15286 =
    // 2*amp*max|act| -- the uninitialized-KFC-accumulator signature;
    // diag6 saw 2, diag8 saw 1).  A fixed settle count cannot cover that.
    // Instead: launch on a fixed deterministic probe, compare against a
    // host-side expected result, and only declare the path warm once the
    // probe verifies.  Fail loudly (TORCH_CHECK) if it never converges:
    // silent wrong-finite output is strictly worse than a raised error.
    constexpr uint32_t kWarmT = 128, kWarmH = 128, kWarmR = 128;
    constexpr float kWarmAmp = 0.05f;
    auto warmAct = at::ones({kWarmT, kWarmR},
                            act2d.options().dtype(at::kHalf));
    auto warmCtrl = at::full({kWarmT, kWarmH}, 0.25,
                             ctrl2d.options().dtype(at::kHalf));
    auto warmW = at::full({kWarmH, kWarmR}, 0.5,
                          head_bias.options().dtype(at::kHalf));
    auto warmBias = at::zeros({kWarmR},
                              head_bias.options().dtype(at::kFloat));
    auto warmOut = at::empty_like(warmAct);
    // Expected: core = tanh(ctrl @ W + bias) * amp + 1 = tanh(0.25*128*0.5)*0.05 + 1
    const float kWarmCore =
        std::tanh(0.25f * static_cast<float>(kWarmH) * 0.5f) * kWarmAmp + 1.0f;
    auto warmTiling = g_tiling;
    void *warmWs = g_workspace;
    // The cached g_tiling is for THIS call's (t, h, r); the warmup probe
    // has fixed (128, 128, 128) geometry, so generate a matching tiling
    // (tiling-driven M-iteration must match tokenCount or the kernel
    // reads/writes out of bounds).
    auto warmPlatform = platform_ascendc::PlatformAscendCManager::GetInstance(
        MWG_SOC_VERSION);
    warmTiling = GenerateTiling(warmPlatform, kWarmT, kWarmR, kWarmH, 1u);
    bool warmOk = false;
    for (uint32_t attempt = 0; attempt < 16 && !warmOk; ++attempt) {
      ephemeral_core_apply_kernel<<<1u, nullptr, acl_stream>>>(
          static_cast<uint8_t *>(warmAct.data_ptr()),
          static_cast<uint8_t *>(warmCtrl.data_ptr()),
          static_cast<uint8_t *>(warmW.data_ptr()),
          static_cast<uint8_t *>(warmBias.data_ptr()),
          static_cast<uint8_t *>(warmOut.data_ptr()),
          static_cast<uint8_t *>(warmWs), warmTiling,
          kWarmAmp, kWarmT, kWarmH, kWarmR);
      aclrtSynchronizeStream(acl_stream);
      auto hostOut = warmOut.to(at::kCPU).to(at::kFloat);
      // Bad-path signature: |out - 1| ~ 0.05 (tanh saturated or zeros).
      warmOk = bool((hostOut - kWarmCore).abs().max().item<float>()
                    < 5e-3f);
    }
    TORCH_CHECK(warmOk,
                "mwg: ephemeral_core_apply warmup failed to converge "
                "after 16 attempts (KFC/aicore path did not initialize)");
    g_settle_done = 1;
  }
  {
    ephemeral_core_apply_kernel<<<block_dim, nullptr, acl_stream>>>(
      static_cast<uint8_t *>(act2d.data_ptr()),
      static_cast<uint8_t *>(a_f16.data_ptr()),
      static_cast<uint8_t *>(b_f16.data_ptr()),
      static_cast<uint8_t *>(head_bias.data_ptr()),
      static_cast<uint8_t *>(out.data_ptr()),
      static_cast<uint8_t *>(workspace_ptr), tiling,
      static_cast<float>(amplitude), t, h, r);
  }
  // The launch is async: the fp16-cast temporaries and the raw workspace
  // must stay alive until the kernel completes, or the caching allocator
  // can hand their bytes to later ops (observed as non-deterministic
  // garbage/NaN outputs).
  aclrtSynchronizeStream(acl_stream);
  return out.view(rank_activation.sizes());
}
}  // namespace mwg

TORCH_LIBRARY(mwg, m) {
  m.def("ephemeral_core_apply(Tensor rank_activation, Tensor controller_hidden, "
        "Tensor head_weight, Tensor head_bias, float amplitude) -> Tensor");
}
TORCH_LIBRARY_IMPL(mwg, PrivateUse1, m) {
  m.impl("ephemeral_core_apply", TORCH_FN(mwg::ephemeral_core_apply));
}
